{
  "name": "score-follower-frontend",
  "version": "0.1.0",
  "description": "Electron frontend for the piano score-following engineering thesis (MusicXML + live audio synchronisation).",
  "author": "Piotr Siewko, Jakub Ramsza",
  "license": "UNLICENSED",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run"
  },
  "dependencies": {
    "opensheetmusicdisplay": "^1.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^37.2.0",
    "electron-vite": "^3.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
